    "auth": {
      "type": "object",
      "properties": {
        "access_token": {
          "title": "",
          "type": "string",
          "description": "The long-lived `Access token` along with the `client_id` and `client_secret` parameters carry the information necessary to query the Facebook Ads API. Use either `access_token` or `user_access_token`, not both at the same time."
        },
        "client_access": {
          "type": "object",
          "properties": {
            "client_id": {
              "title": "",
              "type": "string",
              "description": "`Client ID` of your Facebook client application."
            },
            "client_secret": {
              "title": "",
              "type": "string",
              "description": "`Client Secret` of your Facebook client application."
            }
          },
          "description": "Your application client access fields."
        },
        "user_access_token": {
          "title": "",
          "type": "string",
          "description": "System User Token. Use in combination with `client_id` and `client_secret`. Use either `user_access_token` (for system token) or `access_token` (for user access token), not both at the same time."
        }
      },
      "description": ""
    },
    "external_secrets_keys_config": {
      "type": "object",
      "properties": {
        "user_access_token": {
          "title": "",
          "type": "string",
          "description": "ESM key for system User Token"
        }
