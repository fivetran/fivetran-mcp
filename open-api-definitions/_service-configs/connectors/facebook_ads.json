            "AllAccounts",
            "SpecificAccounts"
          ]
        },
        "timeframe_months": {
          "title": "",
          "type": "object",
          "description": "Number of months' worth of reporting data you'd like to include in your initial sync. This cannot be modified once the connector is created. Default value: `THREE`.",
