{
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "properties": {
        "always_encrypted": {
          "title": "",
          "type": "boolean",
          "description": "Require TLS through Tunnel"
        },
        "auth_method": {
          "title": "",
