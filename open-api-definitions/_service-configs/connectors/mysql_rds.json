        },
        "client_private_key": {
          "title": "",
          "type": "string",
          "description": "Client Private Key in .pem format.",
          "format": "password"
        },
        "client_public_certificate": {
          "title": "",
          "type": "string",
          "description": "Client Certificate in .pem format."
        },
        "connection_type": {
          "title": "",
          "type": "object",
          "description": "Possible values:`Directly`, `PrivateLink`, `SshTunnel`. `SshTunnel` is used as a value if this parameter is omitted in the request and any of the following parameter's values is specified: `tunnel_host`, `tunnel_port`, `tunnel_user`. Otherwise, `Directly` is used as a value if the parameter is omitted.",
          "enum": [
            "Directly",
            "PrivateLink",
            "SshTunnel",
            "ProxyAgent"
          ]
        },
        "database": {
          "title": "",
          "type": "string",
          "description": "The database name."
        },
        "host": {
          "title": "",
          "type": "string",
          "description": "DB instance host or IP address."
        },
        "password": {
          "title": "",
          "type": "string",
          "description": "The user's password.",
          "format": "password"
        },
        "port": {
          "title": "",
          "type": "integer",
          "description": "The port number.",
          "format": "int32"
        },
        "replica_id": {
          "title": "",
          "type": "integer",
          "description": "Unique ID within the MySQL replica set. Must be an integer different from all other master and replica servers within the same group.",
          "format": "int32"
        },
        "role_arn": {
          "title": "",
          "type": "string",
          "description": "The ARN of the IAM role with RDS permissions. Required if the authentication method is `AWS_IAM` in the SaaS Deployment model.",
          "format": "password"
        },
        "tunnel_host": {
          "title": "",
          "type": "string",
          "description": "SSH host, specify only to connect via an SSH tunnel (do not use a load balancer)."
        },
        "tunnel_port": {
          "title": "",
          "type": "integer",
          "description": "SSH port, specify only to connect via an SSH tunnel.",
          "format": "int32"
        },
        "tunnel_user": {
          "title": "",
          "type": "string",
          "description": "SSH user, specify only to connect via an SSH tunnel."
        },
        "update_method": {
          "title": "",
          "type": "object",
          "description": "The method to detect new or changed rows. <br>Supported values:<br>`BINLOG` - Fivetran uses your binary logs (also called binlogs) to request only the data that has changed since our last sync. This is the default value if no value is specified. <br>`TELEPORT` - Fivetran's proprietary replication method that uses compressed snapshots to detect and apply changes.",
          "enum": [
            "BINLOG",
            "TELEPORT"
          ]
        },
        "user": {
          "title": "",
          "type": "string",
          "description": "The user name."
        }
      },
      "description": ""
    }
