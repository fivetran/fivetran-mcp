{
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "properties": {
        "always_encrypted": {
          "title": "",
          "type": "boolean",
          "description": "Specifies whether TLS is required. Must be set when using `SshTunnel` connection"
        },
        "auth_method": {
          "title": "",
          "type": "object",
          "description": "Authentication method. Supported values: `PASSWORD`, `AWS_IAM`. Default: `PASSWORD`.",
          "enum": [
            "PASSWORD",
            "AWS_IAM"
          ]
        },
        "aws_region_code": {
          "title": "",
          "type": "object",
          "description": "AWS region code. Required when `auth_method` is set to `AWS_IAM`",
          "enum": [
            "me-central-1",
            "aws-cn-global",
            "us-isof-south-1",
            "ap-east-2",
