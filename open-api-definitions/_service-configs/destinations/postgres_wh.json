            "aws-iso-b-global",
            "aws-iso-f-global",
            "aws-us-gov-global",
            "us-isob-east-1",
            "us-isof-east-1"
          ]
        },
        "connection_type": {
          "title": "",
          "type": "object",
          "description": "Connection method. Supported values: `Directly`, `SshTunnel`, `ProxyAgent`, `PrivateLink`. Default: `Directly`. Note: PrivateLink is only supported for cloud-hosted PostgreSQL (RDS, Aurora, Azure, GCP).",
          "enum": [
            "Directly",
            "PrivateLink",
            "SshTunnel",
            "ProxyAgent"
          ]
        },
        "database": {
          "title": "",
          "type": "string",
          "description": "Database name"
        },
        "external_id": {
          "title": "",
          "type": "string",
          "description": "AWS external ID for authentication. Auto-generated from group ID when `auth_method` is set to `AWS_IAM`"
        },
        "host": {
          "title": "",
          "type": "string",
          "description": "Server hostname or IP address"
        },
        "password": {
          "title": "",
          "type": "string",
          "description": "Database user password. Required for PASSWORD authentication",
          "format": "password"
        },
        "port": {
          "title": "",
          "type": "integer",
          "description": "Server port number (default: 5432)",
          "format": "int32"
        },
        "role_arn": {
          "title": "",
          "type": "string",
          "description": "AWS IAM role ARN for authentication. Required when `auth_method` is set to `AWS_IAM`"
        },
        "tunnel_host": {
          "title": "",
          "type": "string",
          "description": "SSH server hostname. Required when `connection_type` is set to `SshTunnel`"
        },
        "tunnel_port": {
          "title": "",
          "type": "integer",
          "description": "SSH server port. Required when `connection_type` is set to `SshTunnel`",
          "format": "int32"
        },
        "tunnel_user": {
          "title": "",
          "type": "string",
          "description": "SSH user name. Required when `connection_type` is set to `SshTunnel`"
        },
        "user": {
          "title": "",
          "type": "string",
          "description": "Database user name. Required for PASSWORD authentication"
        }
      },
      "description": ""
    }
